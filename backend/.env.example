# OpenAI secret key: keep it in backend/.env only (git-ignored). Never put it in the frontend.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# RAG retrieval
RAG_TOP_K=3
RAG_MIN_SCORE=0.30

# Retrieval backend: local (rag_index.json) or openai_file_search (OpenAI vector store)
RAG_BACKEND=local
# Optional: pin a vector store. Empty = the one created by `python -m app.file_search sync`
OPENAI_VECTOR_STORE_ID=
FILE_SEARCH_MIN_SCORE=0.40

# Comma-separated list of origins allowed to call the API (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173
