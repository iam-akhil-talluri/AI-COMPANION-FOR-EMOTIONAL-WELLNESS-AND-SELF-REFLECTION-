# Copy to .env and fill in the values. Do not commit .env.

# development | test | demo | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# MySQL 8 connection URL. Create the database, then run: alembic upgrade head
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/wellness_companion
# If unset, a local SQLite file (data/app.db) is used.

# Set to false to store no message text
STORE_TRANSCRIPTS=true
# Delete conversation text older than this many days (0 disables)
RETENTION_DAYS=30
# Purge interval in hours (0 disables)
RETENTION_INTERVAL_HOURS=24

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required in production. If empty outside production, a temporary key is used.
JWT_SECRET=
# Token lifetime in minutes
JWT_EXPIRE_MINUTES=480
# Allow self-registration
ALLOW_REGISTRATION=true

# Number of recent messages passed to the reply provider
CONTEXT_MESSAGES=8

MAX_MESSAGE_CHARS=2000
MAX_MESSAGES_PER_SESSION=100
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=120

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Serve API docs at /docs (always disabled in production)
ENABLE_API_DOCS=true
