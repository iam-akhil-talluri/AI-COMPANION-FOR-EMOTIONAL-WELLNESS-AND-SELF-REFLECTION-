# Copy to .env and fill in the values. Do not commit .env.

# development | test | demo | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# MySQL 8 connection URL. Create the database, then run: alembic upgrade head
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/wellness_companion
# If unset, a local SQLite file (data/app.db) is used.

# Set to false to store no message text
STORE_TRANSCRIPTS=true
# Delete conversation text older than this many days (0 disables)
RETENTION_DAYS=30
# Purge interval in hours (0 disables)
RETENTION_INTERVAL_HOURS=24

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required in production. If empty outside production, a temporary key is used.
JWT_SECRET=
# Token lifetime in minutes
JWT_EXPIRE_MINUTES=480
# Allow self-registration
ALLOW_REGISTRATION=true
# Code that lets someone create an administrator account from the sign-in page
# ("Create an administrator account"). At least 12 characters; keep it secret.
# Empty = admins can only be created with: python -m scripts.create_admin
ADMIN_REGISTRATION_CODE=

# Number of recent messages of the session passed to the AI (30 = about 15 exchanges)
CONTEXT_MESSAGES=30

# Journal entries (Coping Tools): longest entry in characters, and entries per user per hour
MAX_JOURNAL_CHARS=5000
JOURNAL_ENTRIES_PER_HOUR=30

# --- Cross-session memory ----------------------------------------------------
# A short, safety-checked note is written for each session once it goes quiet;
# the newest notes from a user's other sessions are sent with each reply.
# Users can turn it off and view or delete their notes. Crisis sessions are never summarized.
MEMORY_ENABLED=true
# Notes sent with each reply
MEMORY_SESSIONS=3
# Sessions with fewer messages are not summarized
MEMORY_MIN_MESSAGES=4
# A session is summarized once it has been quiet this long (minutes)
MEMORY_IDLE_MINUTES=20
# How often the background job runs (minutes; 0 = off)
MEMORY_INTERVAL_MINUTES=10
# Output token cap for one summary
MEMORY_SUMMARY_MAX_TOKENS=120

# --- Conversational AI and safety (OpenAI) ----------------------------------
# Never commit a real key. Locally it goes in .env; in AWS, in Secrets Manager.
# Without a key, everyday messages get 503 reply_unavailable; crisis and support
# messages still get the reviewed support response and resources.
OPENAI_API_KEY=
# gpt-4o-mini: cheapest model that tested well here (about $0.00013 per message)
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=1
# Caps reply length (and cost)
AI_MAX_OUTPUT_TOKENS=300
# Leave empty to use the model's default temperature
AI_TEMPERATURE=0.6
# Second safety opinion from the free OpenAI Moderation API. If it is on and
# cannot be reached, messages are refused (fail closed) with 503 safety_unavailable.
USE_OPENAI_MODERATION=true
# USD per 1 million tokens for cost estimates (gpt-4o-mini). Check current pricing.
PRICE_INPUT_PER_MILLION=0.15
PRICE_OUTPUT_PER_MILLION=0.60
# Optional monthly AI spending cap in USD (empty = no cap)
AI_MONTHLY_BUDGET_USD=

MAX_MESSAGE_CHARS=2000
MAX_MESSAGES_PER_SESSION=100
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=120

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Serve API docs at /docs (always disabled in production)
ENABLE_API_DOCS=true
